# Copia este archivo a .env antes de arrancar el servidor:
#   cp .env.example .env     (en Windows: copy .env.example .env)

PORT=3000

# MariaDB local (ajusta usuario y clave a tu instalación)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=inventario

# Cadena larga y aleatoria para firmar los JWT (mínimo 32 caracteres).
# Obligatoria. Genera una con: openssl rand -hex 32
JWT_SECRET=

# Orígenes permitidos para CORS, separados por coma. Vacío = sin CORS,
# que es lo habitual cuando el cliente usa el proxy de Vite o el mismo origen.
CORS_ORIGINS=

# 1 si la API está detrás de un proxy inverso y debe confiar en X-Forwarded-For.
TRUST_PROXY=0

# 1 desactiva el límite de intentos; solo para pruebas controladas.
RATE_LIMIT_DISABLED=0
