# Copia este archivo a .env antes de arrancar el servidor:
#   cp .env.example .env     (en Windows: copy .env.example .env)

PORT=3000

# MariaDB local (ajusta usuario y clave a tu instalación)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=root
DB_NAME=inventario

# Cadena larga y aleatoria para firmar los JWT
JWT_SECRET=cambia-este-valor-por-una-cadena-larga-y-aleatoria
