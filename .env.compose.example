# Copia este archivo a .env en la raíz del repositorio:
#   cp .env.compose.example .env     (en Windows: copy .env.compose.example .env)
# Docker Compose lo usa para sustituir variables en docker-compose.yml.

# Credencial de root de MariaDB dentro del contenedor.
# Obligatoria: Docker Compose no arranca si queda vacía.
# Genera un valor con: openssl rand -hex 32
DB_ROOT_PASSWORD=

# Usuario de aplicación creado por MariaDB dentro del contenedor.
# La API usa este usuario, nunca root. Necesita DDL sobre DB_NAME para migrar.
DB_APP_USER=signal
DB_APP_PASSWORD=

# Nombre de la base creada por el contenedor
DB_NAME=inventario

# Cadena larga y aleatoria para firmar los JWT.
# Obligatoria: usa un valor distinto al de la base.
# Genera otro valor con: openssl rand -hex 32
JWT_SECRET=

# Orígenes permitidos para CORS, separados por coma. El cliente usa el proxy
# de Vite, así que normalmente puede quedar vacío.
CORS_ORIGINS=

# 1 si la API está detrás de un proxy inverso con TLS.
TRUST_PROXY=0

# 1 expone /api/docs y /api/openapi.json. El kit de producción fija 0 por defecto.
API_DOCS_ENABLED=0

# Nivel de logs estructurados: debug, info, warn, error o silent.
LOG_LEVEL=info

# Puertos del kit de desarrollo (cámbialos si ya tienes servicios en ellos).
# En el kit de producción (docker-compose.prod.yml) solo se usa WEB_PORT: Nginx
# escucha en 8080 dentro del contenedor y MariaDB/API no se publican al host.
MARIADB_HOST_PORT=3306
API_PORT=3000
WEB_PORT=5173
