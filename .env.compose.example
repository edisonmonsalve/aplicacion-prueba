# Copia este archivo a .env en la raíz del repositorio:
#   cp .env.compose.example .env     (en Windows: copy .env.compose.example .env)
# Docker Compose lo usa para sustituir variables en docker-compose.yml.

# Credencial de root de MariaDB dentro del contenedor
DB_ROOT_PASSWORD=root

# Nombre de la base creada por el contenedor
DB_NAME=inventario

# Cadena larga y aleatoria para firmar los JWT
JWT_SECRET=cambia-este-secreto-por-una-cadena-larga-y-aleatoria

# Puertos expuestos en el host (cámbialos si ya tienes servicios en ellos)
MARIADB_HOST_PORT=3306
API_PORT=3000
WEB_PORT=5173
